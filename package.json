{
  "name": "crm-monorepo",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "eslint": "^8.57.1"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": ["eslint --fix", "prettier --write"],
    "**/*.{json,css,md}": ["prettier --write"]
  }
}
