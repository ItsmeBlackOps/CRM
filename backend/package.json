{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsup src/server.ts --format esm,cjs --dts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.1",
    "pino": "^8.17.0",
    "socket.io": "^4.7.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/bcryptjs": "^2.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.11.17",
    "@eslint/js": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.13.0",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^7.2.0",
    "pino-pretty": "^11.0.0",
    "typescript": "^5.4.5",
    "mongodb-memory-server": "^10.1.4",
    "ioredis-mock": "^5.9.1",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "redis-commands": "^1.7.0"
  }
}
